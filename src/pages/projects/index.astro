---
import { t, changeLanguage } from "i18next";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { projectInfo, byPriority, isPublished } from "../../data/site";

changeLanguage("es");

const projects = (await getCollection("projects", isPublished)).sort(byPriority).map(projectInfo);
const count = (category: string) => projects.filter((project) => project.category === category).length;
const filters = [
    { id: "all", label: t("projects.all"), total: projects.length },
    { id: "professional", label: t("projects.professional-lab"), total: count("professional") },
    { id: "personal", label: t("projects.personal-lab"), total: count("personal") },
];
---

<BaseLayout title={t("projects.title")} description={t("projects.description")} active="projects">
    <div class="wrap view-pad">
        <div class="page-head">
            <h1 class="page-title">{t("projects.title")}</h1>
            <p class="page-sub">{t("projects.lead")}</p>
        </div>

        <div class="filterbar">
            <div class="filter" role="group" aria-label={t("projects.filter-label")}>
                {filters.map((filter) => (
                    <button type="button" data-filter={filter.id} aria-pressed={filter.id === "all" ? "true" : "false"}>
                        {filter.label}<span class="n">{filter.total}</span>
                    </button>
                ))}
            </div>
            <p class="count" data-count data-template={t("projects.count")} aria-live="polite"></p>
        </div>

        <div class="list-end" data-list>
            {projects.map((info) => <ProjectRow info={info} level="h2" />)}
        </div>
    </div>
</BaseLayout>

<script is:inline>
(function () {
    var buttons = [].slice.call(document.querySelectorAll("[data-filter]"));
    var rows = [].slice.call(document.querySelectorAll("[data-list] .proj"));
    var count = document.querySelector("[data-count]");

    function setFilter(value) {
        var shown = 0;
        rows.forEach(function (row) {
            var on = value === "all" || row.getAttribute("data-cat") === value;
            row.hidden = !on;
            if (on) { shown += 1; }
        });
        buttons.forEach(function (button) {
            button.setAttribute("aria-pressed", String(button.getAttribute("data-filter") === value));
        });
        if (count) {
            count.textContent = count.getAttribute("data-template").replace("{shown}", shown).replace("{total}", rows.length);
        }
    }
    buttons.forEach(function (button) {
        button.addEventListener("click", function () { setFilter(button.getAttribute("data-filter")); });
    });
    setFilter("all");
})();
</script>

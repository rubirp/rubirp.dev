---
import { t, changeLanguage } from "i18next";
import { localizePath } from "astro-i18next";
import BaseLayout from "../../layouts/BaseLayout.astro";

changeLanguage("en");
---

<BaseLayout title={t("404.title")} description={t("404.description")}>
    <div class="wrap notfound">
        <h1 class="page-title">404</h1>
        <p class="page-sub">{t("404.title")}. {t("404.t1")}</p>
        <div class="notfound__actions">
            <a class="btn btn--primary" href={localizePath("/")}>{t("404.b1")}</a>
            <a class="btn btn--line" href={localizePath("/projects")}>{t("404.b2")}</a>
            <a class="btn btn--line" href={localizePath("/cv")}>{t("404.b3")}</a>
        </div>
    </div>
</BaseLayout>

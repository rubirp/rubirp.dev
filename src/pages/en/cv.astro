---
import { Trans } from "astro-i18next/components";
import { localizePath } from "astro-i18next";
import i18next, { t, changeLanguage } from "i18next";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EMAIL, jobs, formatPeriod } from "../../data/site";

changeLanguage("en");

const isSpanish = i18next.language === "es";
const sections = [
    { id: "perfil", label: t("cv.summary-t") },
    { id: "experiencia", label: t("cv.experience-t") },
    { id: "educacion", label: t("cv.education-t") },
    { id: "tecnologias", label: t("cv.technologies-t") },
    { id: "habilidades", label: t("cv.skills-t") },
];
const education = [1, 2];
const technologies = [
    { label: t("cv.technologies-s1"), items: ["Cocos Creator", "Unity", "Godot", "PhaserJS", "SFML"] },
    { label: t("cv.technologies-s2"), items: ["TypeScript", "JavaScript", "C/C++", "C#", "HTML", "CSS"] },
    { label: t("cv.technologies-s3"), items: ["Git", "Jenkins", "Jest", "Cypress", "Spine", "Jira", "Trello", "Perforce"] },
];
const skills = [1, 2, 3, 4, 5];
---

<BaseLayout title={t("cv.title")} description={t("cv.description")} active="cv">
    <div class="wrap">
        <div class="page-head">
            <h1 class="page-title">{t("cv.page-title")}</h1>
            <p class="page-sub">{t("cv.lead")}</p>
            <div class="cv-actions">
                <a class="btn btn--ink" href={isSpanish ? "/docs/cv-es.pdf" : "/docs/cv-en.pdf"} target="_blank" rel="noopener">{t("links.curriculum")}</a>
                <a class="btn btn--line" href={"mailto:" + EMAIL}>{t("sidebar.rubi.contact")}</a>
            </div>
        </div>

        <div class="cv">
            <nav class="cv__index" aria-label={t("cv.index-label")}>
                {sections.map((section) => <a href={"#" + section.id}>{section.label}</a>)}
            </nav>

            <div>
                <section class="cv-sec" id="perfil">
                    <h2 class="h2">{t("cv.summary-t")}</h2>
                    <div class="prose">
                        <Trans i18nKey="cv.summary-d">
                            <p></p>
                        </Trans>
                    </div>
                </section>

                <section class="cv-sec" id="experiencia">
                    <h2 class="h2">{t("cv.experience-t")}</h2>
                    {jobs.map((job) => (
                        <article class="job">
                            <div class="job__when">
                                <p class="job__dates">
                                    {formatPeriod(job).from} – {job.to === null ? <span class="now">{t("cv.now")}</span> : formatPeriod(job).to}
                                </p>
                                <p class="job__where">{t(`${job.key}.where`)}</p>
                            </div>
                            <div>
                                <h3 class="job__org">{t(`${job.key}.org`)}</h3>
                                <p class="job__role">{t(`${job.key}.role`)}</p>
                                <p class="job__text">{t(`${job.key}.description`)}</p>
                                <ol class="subs">
                                    {job.projects.map((project) => {
                                        const title = t(`${job.key}.${project.n}.title`);
                                        return (
                                            <li>
                                                <h4 class="sub__title">
                                                    {project.slug
                                                        ? <a href={localizePath("/projects/" + project.slug)}>{title}</a>
                                                        : project.url
                                                            ? <a href={project.url} target="_blank" rel="noopener noreferrer">{title}</a>
                                                            : title}
                                                </h4>
                                                <p class="sub__role">{t(`${job.key}.${project.n}.subtitle`)}</p>
                                                <p class="sub__did">{t(`${job.key}.${project.n}.description`)}</p>
                                            </li>
                                        );
                                    })}
                                </ol>
                            </div>
                        </article>
                    ))}
                </section>

                <section class="cv-sec" id="educacion">
                    <h2 class="h2">{t("cv.education-t")}</h2>
                    {education.map((n) => (
                        <article class="job">
                            <div class="job__when">
                                <p class="job__dates">{t(`cv.education-tl-d${n}`)}</p>
                                <p class="job__where">{t(`cv.education-tl-w${n}`)}</p>
                            </div>
                            <div>
                                <h3 class="job__org">{t(`cv.education-tl-t${n}`)}</h3>
                                <p class="job__role">{t(`cv.education-tl-o${n}`)}</p>
                            </div>
                        </article>
                    ))}
                </section>

                <section class="cv-sec" id="tecnologias">
                    <h2 class="h2">{t("cv.technologies-t")}</h2>
                    {technologies.map((group) => (
                        <div class="tech">
                            <h3 class="tech__label">{group.label}</h3>
                            <ul class="chips">{group.items.map((item) => <li>{item}</li>)}</ul>
                        </div>
                    ))}
                </section>

                <section class="cv-sec" id="habilidades">
                    <h2 class="h2">{t("cv.skills-t")}</h2>
                    <ul class="chips">{skills.map((n) => <li>{t(`cv.skill-${n}`)}</li>)}</ul>
                </section>
            </div>
        </div>
    </div>
</BaseLayout>

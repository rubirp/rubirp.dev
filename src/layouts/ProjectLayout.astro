---
import { t } from "i18next";
import { localizePath } from "astro-i18next";
import { Trans } from "astro-i18next/components";
import BaseLayout from "./BaseLayout.astro";
import Spec from "../components/Spec.astro";
import Gallery from "../components/Gallery.astro";
import { projectInfo } from "../data/site";

/* Ficha de un proyecto: imágenes, texto y panel de datos. */
const { entry } = Astro.props;
const data = entry.data;
const info = projectInfo(entry);

type Media = { url: string; alt: string };
const images: Media[] = data.main_media ? [data.main_media] : (data.media ?? []).filter((item: Media) => item.url);
---

<BaseLayout title={info.title} description={t(data.description)} active="projects">
    <div class="wrap view-pad">
        <div class="page-head">
            <p class="crumb"><a href={localizePath("/projects")}>{t("projects.back")}</a></p>
            <h1 class="page-title">{info.title}</h1>
            <p class="page-sub">{info.tagline}</p>
        </div>

        <div class="detail">
            <article>
                {images.length > 0 && <div class="detail__media"><Gallery images={images} /></div>}
                <div class="prose">
                    {data.content && (
                        <Trans i18nKey={data.content}>
                            <p></p>
                        </Trans>
                    )}
                    <slot />
                </div>
            </article>
            <Spec info={info} />
        </div>
    </div>
</BaseLayout>

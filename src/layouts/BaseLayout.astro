---
import i18next, { t } from "i18next";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { SITE_TITLE } from "../consts";

const { title, description, active } = Astro.props;
---

<!DOCTYPE html>
<html lang={i18next.language}>
    <head>
        <BaseHead title={SITE_TITLE + " | " + title} description={description} />
        <!-- El tema se fija antes de pintar: el elegido a mano o, si no hay, el del sistema. -->
        <script is:inline>
            (function () {
                var theme = null;
                try { theme = localStorage.getItem("color-theme"); } catch (e) {}
                if (theme !== "light" && theme !== "dark") {
                    theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
    </head>

    <body>
        <a class="skip" href="#contenido">{t("nav.skip")}</a>
        <Header active={active} />
        <main id="contenido" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
